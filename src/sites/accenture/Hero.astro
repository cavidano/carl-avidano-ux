---
import IntroPanel from '../../components/Applications/IntroPanel/index.astro';
import artwork from './images/purple-abstract-backdrop.png';
import copy from './site.json';
---

<IntroPanel
  image={artwork}
  logo={{
    alt: 'Accenture',
    light: { src: '/accenture/accenture-logo-light.svg', width: 153, height: 40 },
    dark: { src: '/accenture/accenture-logo-dark.svg', width: 153, height: 40 }
  }}
  headline={copy.home.panelHeading}
  introduction={copy.home.introduction}
/>
