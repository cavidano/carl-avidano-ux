---
import IntroPanel from '../../components/Applications/IntroPanel/index.astro';
import artwork from './images/chromatic-chart.png';
import copy from './site.json';
---

<IntroPanel
  image={artwork}
  logo={{
    alt: 'Chromatic',
    light: { src: '/chromatic/chromatic-logo-light.svg', width: 120, height: 24 },
    dark: { src: '/chromatic/chromatic-logo-dark.svg', width: 120, height: 24 }
  }}
  headline={copy.home.panelHeading}
  introduction={copy.home.introduction}
/>
