---
import IntroPanel from '../../components/Applications/IntroPanel/index.astro';
import artwork from './images/new-york-city-at-night.png';
import copy from './site.json';
---

<IntroPanel
  image={artwork}
  logo={{
    alt: 'BNY',
    light: { src: '/bny/bny-logo-light.svg', width: 84, height: 18 },
    dark: { src: '/bny/bny-logo-dark.svg', width: 84, height: 18 }
  }}
  headline={copy.home.panelHeading}
  introduction={copy.home.introduction}
/>
