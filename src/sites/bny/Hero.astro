---
import ApplicationHero from '../../components/ApplicationHero.astro';
import skyline from './images/new-york-city-at-night.png';
import copy from './site.json';

// Maximum logo width in pixels. Height follows the SVG's 84:18 proportions.
const logoMaxWidth = 840;
---

<ApplicationHero
  image={skyline}
  logo={{
    light: '/bny/bny-logo-light.svg',
    dark: '/bny/bny-logo-dark.svg',
    alt: 'BNY',
    width: logoMaxWidth,
    height: Math.round(logoMaxWidth * 18 / 84)
  }}
  headline={copy.home.headline}
  introduction={copy.home.introduction}
/>
