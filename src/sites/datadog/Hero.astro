---
import IntroPanel from '../../components/Applications/IntroPanel/index.astro';
import artwork from './images/datadog-brand-pattern.png';
import copy from './site.json';
---

{import.meta.env.DEV && <script is:inline src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>}

<IntroPanel
  image={artwork}
  logo={{
    alt: 'Datadog',
    light: { src: '/datadog/datadog-logo-light.svg', width: 800.5, height: 203.19 },
    dark: { src: '/datadog/datadog-logo-dark.svg', width: 800.5, height: 196.2 }
  }}
  headline={copy.home.panelHeading}
  introduction={copy.home.introduction}
/>
