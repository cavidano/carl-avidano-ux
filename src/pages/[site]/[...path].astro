---
import ApplicationHomePage from '../../components/Applications/ApplicationHomePage.astro';
import ApplicationAboutPage from '../../components/Applications/ApplicationAboutPage.astro';
import MainAboutPage from '../about.astro';
import ProjectPage from '../../components/Pages/ProjectPage.astro';
import PostPage from '../../components/Pages/PostPage.astro';
import NotFoundPage from '../../components/Pages/NotFoundPage.astro';
import ApplicationDrawingBoardPage from '../../components/Applications/ApplicationDrawingBoardPage.astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { getApplicationSites } from '../../lib/application-sites.js';
import { getAllProjects } from '../../lib/projects.js';
import { hasApplicationAboutPage } from '../../lib/about.js';
import { getDrawingBoardPosts, getDrawingBoardTags } from '../../lib/drawing-board.js';

export function getStaticPaths() {
  const sites = getApplicationSites({ includeDrafts: import.meta.env.DEV || process.env.APPLICATION_PREVIEW === 'true' });
  return sites.flatMap((site) => [
    { params: { path: undefined }, props: { kind: 'home' } },
    { params: { path: 'about' }, props: { kind: 'about' } },
    { params: { path: 'drawing-board' }, props: { kind: 'articles', posts: getDrawingBoardPosts(site) } },
    { params: { path: '404' }, props: { kind: 'notFound' } },
    ...getAllProjects(site).map((project) => ({
      params: { path: `case-studies/${project.slug}` }, props: { kind: 'project', project }
    })),
    ...getDrawingBoardPosts(site).map((post) => ({
      params: { path: `drawing-board/${post.slug}` }, props: { kind: 'post', post }
    })),
    ...getDrawingBoardTags(site).map((tag) => ({
      params: { path: `drawing-board/topics/${tag.slug}` }, props: { kind: 'articles', posts: tag.posts, tag }
    }))
  ].map((route) => ({ ...route, params: { ...route.params, site } })));
}

const heroes = import.meta.glob<AstroComponentFactory>('../../sites/*/Hero.astro', { eager: true, import: 'default' });
const Hero = heroes[`../../sites/${Astro.params.site}/Hero.astro`];
if (!Hero) throw new Error(`Application ${Astro.params.site}: missing Hero.astro.`);
const { kind, project, post, posts, tag } = Astro.props;
const AboutPage = hasApplicationAboutPage(Astro.params.site) ? ApplicationAboutPage : MainAboutPage;
---
{kind === 'home' && <ApplicationHomePage><Hero slot="hero" /></ApplicationHomePage>}
{kind === 'about' && <AboutPage />}
{kind === 'project' && project && <ProjectPage project={project} />}
{kind === 'post' && post && <PostPage post={post} />}
{kind === 'articles' && <ApplicationDrawingBoardPage posts={posts ?? []} currentTag={tag} />}
{kind === 'notFound' && <NotFoundPage />}
