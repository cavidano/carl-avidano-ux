---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header/Header.astro';
import DeskPostMeta from '../../components/DeskPostMeta.astro';
import { getDeskPosts, formatDeskDate } from '../../lib/desk.js';

export function getStaticPaths() {
  return getDeskPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, frontmatter, image } = post;
const otherPosts = getDeskPosts().filter(({ slug }) => slug !== post.slug);
---
<Layout
  title={`${frontmatter.title} • On my desk • Carl Avidano`}
  description={frontmatter.description}
  image={image}
  imageAlt={frontmatter.imageAlt}
  noindex
>
  <Header />

  <main id="skip-header-target" class="margin-y-5">
    <article>
      <header class="container medium text-align-center margin-bottom-4">
        <DeskPostMeta frontmatter={frontmatter} class="justify-content-center" />
        <h1 class="banner-headline">{frontmatter.title}</h1>
      </header>

      <div class="container narrow">
        <Content />
      </div>

      <footer class="container narrow margin-top-4">
        <div class="border-top padding-top-3">
          <p class="font-size-sm margin-bottom-1">Posted <time datetime={frontmatter.date}>{formatDeskDate(frontmatter.date)}</time></p>
          <a class="link" href={frontmatter.projectUrl}>Explore the {frontmatter.projectName} case study <span aria-hidden="true">→</span></a>
        </div>
      </footer>
    </article>

    {otherPosts.length > 0 && <nav class="container narrow margin-top-5" aria-label="More from On my desk">
      <div class="border-top padding-top-3">
        <p class="font-size-sm margin-bottom-2">Also on my desk</p>
        <ul class="grid gap-3">
          {otherPosts.map(({ slug, frontmatter: other }) => (
            <li><a class="link h4" href={`/on-my-desk/${slug}`}>{other.title} <span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
    </nav>}
  </main>
</Layout>
