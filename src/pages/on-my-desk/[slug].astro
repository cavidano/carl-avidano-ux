---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header/Header.astro';
import LinkOpenNew from '../../components/LinkOpenNew.astro';
import { getDeskPosts, formatDeskDate, getDeskImageOptions } from '../../lib/desk.js';

export function getStaticPaths() {
  return getDeskPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, frontmatter, image } = post;
const featureImage = await getImage({ ...getDeskImageOptions(image), format: 'jpg' });
const usefulLinks = [
  { label: frontmatter.projectLinkLabel ?? `${frontmatter.projectName} case study`, url: frontmatter.projectUrl },
  ...(frontmatter.usefulLinks ?? [])
];
const otherPosts = getDeskPosts().filter(({ slug }) => slug !== post.slug);
---
<Layout
  title={`${frontmatter.title} • On my desk • Carl Avidano`}
  description={frontmatter.description}
  image={featureImage.src}
  imageAlt={frontmatter.imageAlt}
  noindex
>
  <Header />

  <main id="skip-header-target" class="margin-y-5">
    <article>
      <header class="container medium text-align-center margin-bottom-5">
        <p class="font-size-sm margin-bottom-2">{frontmatter.topic}</p>
        <h1 class="banner-headline margin-bottom-3">{frontmatter.title}</h1>
        <p class="font-size-sm margin-bottom-0">
          {frontmatter.workDate ? (
            <span>From the archive · <time datetime={frontmatter.workDate}>{formatDeskDate(frontmatter.workDate)}</time></span>
          ) : (
            <time datetime={frontmatter.date}>{formatDeskDate(frontmatter.date)}</time>
          )}
        </p>
      </header>

      <div class="container narrow">
        {frontmatter.brief && <section class="subtle-fill-1 padding-3 margin-bottom-5">
          <h2 class="font-size-sm margin-bottom-1">TLDR</h2>
          <p class="margin-bottom-0">{frontmatter.brief}</p>
        </section>}
        <Content />
      </div>

      <footer class="container narrow margin-top-4">
        <div class="border-top padding-top-3">
          <h2>Useful links</h2>
          <ul class="grid gap-2">
            {usefulLinks.map(({ label, url }) => (
              <li>
                {/^https?:\/\//.test(url) ? (
                  <LinkOpenNew LinkUrl={url} LinkText={label} utilities="link" />
                ) : (
                  <a class="link" href={url}>{label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </footer>
    </article>

    {otherPosts.length > 0 && <nav class="container narrow margin-top-5" aria-label="More from On my desk">
      <div class="border-top padding-top-3">
        <p class="font-size-sm margin-bottom-2">Also on my desk</p>
        <ul class="grid gap-3">
          {otherPosts.map(({ slug, frontmatter: other }) => (
            <li><a class="link h4" href={`/on-my-desk/${slug}`}>{other.title} <span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
    </nav>}
  </main>
</Layout>
