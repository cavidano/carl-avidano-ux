---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header/Header.astro';
import DeskPostMeta from '../../components/DeskPostMeta.astro';
import { getDeskPosts } from '../../lib/desk.js';

const posts = getDeskPosts();
const description = 'Work in progress, experiments, and notes from past projects.';
---
<Layout title="On my desk • Carl Avidano" description={description} noindex>
  <Header />

  <main id="skip-header-target" class="container wide margin-y-5">
    <header class="narrow margin-bottom-5">
      <h1 class="banner-headline">On my desk</h1>
      <p class="font-size-md margin-bottom-0">{description}</p>
    </header>

    <ul class="grid">
      {posts.map(({ slug, frontmatter, image }, index) => (
        <li class="border-top">
          <article class="grid grid--column-3--lg align-items-center gap-4 padding-y-4">
            <Image
              class="display-block width-100"
              src={image}
              alt=""
              widths={[480, 720, 960]}
              sizes="(min-width: 992px) 32vw, 90vw"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
            <div class="grid__colspan-2--lg narrow">
              <DeskPostMeta frontmatter={frontmatter} />
              <h2 class="h3 margin-bottom-2">
                <a class="link font-weight-bold" href={`/on-my-desk/${slug}`}>{frontmatter.title}</a>
              </h2>
              <p>{frontmatter.description}</p>
              <a class="link" href={`/on-my-desk/${slug}`}>
                <span class="link__text">Read the note<span class="screen-reader-only">: {frontmatter.title}</span></span>
                <span class="icon icon-arrow-right" aria-hidden="true"></span>
              </a>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </main>
</Layout>
