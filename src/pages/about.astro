---
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import GlobalHeader from '../components/GlobalHeader/GlobalHeader.astro';

import SiteLink from '../components/SiteLink.astro';
import portrait from '../images/carl-avidano-16x9.jpg';
import * as defaultAbout from '../content/pages/about.mdx';

const { page = defaultAbout } = Astro.props;
const { default: AboutContent, frontmatter } = page;

const {
  title = defaultAbout.frontmatter.title,
  description = defaultAbout.frontmatter.description,
  portraitAlt = defaultAbout.frontmatter.portraitAlt,
  skills = defaultAbout.frontmatter.skills,
  workHistory = defaultAbout.frontmatter.workHistory,
  earlierExperience = defaultAbout.frontmatter.earlierExperience,
  softwareSkills = defaultAbout.frontmatter.softwareSkills
} = frontmatter;
type WorkHistoryEntry = {
  organization: string;
  role: string;
  period: string;
  highlights: string[];
};
type SoftwareSkillGroup = {
  category: string;
  items: string[];
};
const profile = { ...defaultAbout.frontmatter.profile, ...frontmatter.profile };
const phoneHref = `tel:${profile.phone.replace(/[^\d+]/g, '')}`;
const mdxComponents = {
  a: SiteLink
};
---
<Layout title={title} description={description} image={portrait} imageAlt={portraitAlt}>

  <GlobalHeader />

  <main class="container wide" id="skip-header-target">

    <div class="margin-y-3 margin-y-5--lg position-relative">
      <Image
        class="project-image"
        src={portrait}
        alt={portraitAlt}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <article class="about-page grid grid--column-4--xl gap-3 border-top padding-y-4">

      <div>
        <p class="h6">{profile.name}</p>
        <p>{profile.pronouns}</p>
      </div>

      <div class="grid grid__colspan-3--xl gap-5">

        <section class="grid grid--column-3--lg gap-3">
          <p class="font-size-md margin-bottom-0">Location:<br />{profile.location}</p>

          <div class="grid__colspan-2--lg">
            <AboutContent components={mdxComponents} />
          </div>
        </section>

        <section class="grid grid--column-3--lg gap-3 border-top padding-top-4" id="skills-and-expertise">
          <h2 class="h5 margin-bottom-0">Expertise</h2>

          <div class="grid__colspan-2--lg">
            <ul class="grid gap-2 font-size-md margin-bottom-0">
              {skills.map((skill: string) => (
                <li>{skill}</li>
              ))}
            </ul>
          </div>
        </section>

        <section class="grid grid--column-3--lg gap-3 border-top padding-top-4" id="work-history">
          <h2 class="h5 margin-bottom-0">Work history</h2>

          <div class="grid__colspan-2--lg font-size-md">
            <div class="grid gap-4">
              {workHistory.map(({ organization, role, period, highlights }: WorkHistoryEntry) => (
                <div>
                  <h3 class="h6 margin-bottom-1">{organization} · {role}</h3>
                  <p class="font-size-sm margin-bottom-2">{period}</p>
                  <ul>
                    {highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </div>
              ))}
            </div>
            <p class="margin-top-3 margin-bottom-0"><em>{earlierExperience}</em></p>
          </div>
        </section>

        <section class="grid grid--column-3--lg gap-3 border-top padding-top-4" id="skills-and-software">
          <h2 class="h5 margin-bottom-0">Skills and software</h2>

          <div class="software-skills grid__colspan-2--lg font-size-md">
            {softwareSkills.map(({ category, items }: SoftwareSkillGroup) => (
              <div>
                <h3 class="h6 margin-bottom-2">{category}</h3>
                <ul class="grid gap-1 margin-bottom-0">
                  {items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class="grid grid--column-3--lg gap-3 border-top padding-top-4" id="get-in-touch">
          <h2 class="h5 margin-bottom-0">Get in touch</h2>

          <div class="grid grid--column-2--md gap-4 grid__colspan-2--lg font-size-md">
            <ul class="nav gap-2 margin-bottom-0">
              <li>
                <SiteLink href={phoneHref}>{profile.phone}</SiteLink>
              </li>
              <li>
                <SiteLink href={`mailto:${profile.email}`}>{profile.email}</SiteLink>
              </li>
              <li>
                <SiteLink href="https://www.linkedin.com/in/carlavidano/" target="_blank" rel="noreferrer">LinkedIn</SiteLink>
              </li>
            </ul>

            <div>
              <SiteLink class="button button--has-icon button--outline font-size-md" href="/resume-carl-avidano.pdf" download>
                <span class="icon icon-file-download" aria-hidden="true"></span>
                <span class="button__text">Full résumé (PDF)</span>
              </SiteLink>
            </div>
          </div>
        </section>
      </div>
    </article>

  </main>

</Layout>

<style lang="scss">
  @use '@natura11y/core/src/scss/breakpoint';

  .software-skills {
    column-gap: var(--spacer-4);

    @include breakpoint.breakpoint-up(md) {
      column-count: 2;
    }

    > div {
      break-inside: avoid;

      &:not(:last-child) {
        margin-block-end: var(--spacer-4);
      }
    }
  }
</style>
