---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header/Header.astro';
import Button from '../components/Button.astro';
import LinkOpenNew from '../components/LinkOpenNew.astro';
import ProjectListView from '../components/ProjectListView.astro';
import acluLogo from '../images/aclu/aclu-logo.svg';
import accessibilityAdvocacy from '../images/aclu/accessibility-advocacy.webp';
import statueOfLiberty from '../images/aclu/statue-of-liberty.jpg';
import portrait from '../images/carl-avidano-16x9.jpg';
import { getProjectBySlug } from '../lib/projects.js';

const projectSelections = [
  {
    slug: 'phoenix',
    description: 'Research and UX strategy for a city website serving 1.5 million residents and more than 40 departments, achieving WCAG Level AA conformance at launch.'
  },
  {
    slug: 'natura11y',
    description: 'An accessibility-first design ecosystem connecting Figma libraries, shared design tokens, semantic components, documentation, and production code.'
  },
  {
    slug: 'nyc-oti',
    description: 'End-to-end product design and front-end implementation for public services, emergency communications, complex forms, and internal government tools.'
  },
  {
    slug: 'ladrc',
    description: 'User interviews, usability testing, tree testing, and accessible wireframes for people seeking legal resources during high-stress disaster recovery.'
  }
];

const projects = projectSelections.flatMap(({ slug, description }) => {
  const project = getProjectBySlug(slug);

  if (!project) return [];

  return [{
    ...project,
    frontmatter: {
      ...project.frontmatter,
      description,
      buttonLabel: 'Read the case study'
    }
  }];
});

const title = 'ACLU • Carl Avidano • UX Manager';
const description = 'Selected product design, accessibility, research, and design-system work relevant to the ACLU Senior Product Designer position.';
const portraitAlt = 'Black and white portrait of Carl Avidano';
const strengths = [
  {
    id: 'ux-research',
    title: 'UX research and strategy',
    summary: 'As UX Director at Reingold, I have led qualitative and quantitative UX research for organizations like Phoenix.gov, Maximus, the National Football League, and Legal Aid Disaster Resource Center. Research methods I’ve used include guided interviews, remote and in-person usability testing, user stories, journey mapping, information architecture (tree testing), and low-fidelity prototyping.',
    links: [
      { href: '/portfolio/phoenix', title: 'Phoenix.gov' },
      { href: '/portfolio/ladrc', title: 'LADRC' }
    ]
  },
  {
    id: 'product-design',
    title: 'Product design and systems',
    summary: 'Through my independent practice, Avidano Digital, and roles at Reingold and NYC OTI, I have designed and built digital products and design systems from discovery through delivery.',
    links: [
      { href: '/portfolio/natura11y', title: 'Natura11y' },
      { href: '/portfolio/visionlearning', title: 'Visionlearning' },
      { href: '/portfolio/nyc-oti', title: 'NYC OTI' },
      { href: '/portfolio/cheetah-conservation-fund', title: 'Cheetah Conservation Fund' },
      { href: '/portfolio/unicef', title: 'UNICEF' }
    ]
  },
  {
    id: 'digital-illustration',
    title: 'Digital illustration and visual storytelling',
    summary: 'My background in graphic design and illustration helps me turn complex ideas into clear, memorable stories. My work includes scientific illustration, icon systems, research presentations, and disability-rights advocacy graphics.',
    links: [
      { href: '/portfolio/visionlearning', title: 'Visionlearning' },
      { href: 'https://avidanodigital.com/work/devsmart-group', title: 'DevSmart Group', external: true }
    ]
  },
  {
    id: 'management-mentorship',
    title: 'Management and mentorship',
    summary: 'Across leadership roles at Reingold and NYC OTI, and through Avidano Digital, I have managed and mentored designers at different stages of their careers.',
    links: []
  },
];
---

<Layout title={title} description={description} noindex={true}>

  <Header />

  <main id="skip-header-target">

    <section class="margin-y-5">

      <div class="container wide">
      
          <div
            class="aclu-logo-mask margin-bottom-4 width-100"
            aria-hidden="true"
            style={`--aclu-logo: url('${acluLogo.src}'); --aclu-logo-image: url('${statueOfLiberty.src}')`}
          ></div>

        <div>
          <h1 class="banner-headline margin-bottom-3">
              Why I want to join the ACLU
          </h1>

          <p class="narrow">
            My journey as a disabled designer and accessibility advocate fuels my desire to create meaningful accessible digital experiences. Joining the ACLU’s Technical Department as a Senior Product Designer combines my passion for civil liberties with my commitment to digital inclusion.
          </p>
        </div>

      </div>
    
    </section>

    <div class="container wide margin-y-5">
      <hr />
    </div>

    <section id="selected-work">

      <header class="container wide margin-y-5">
        <div class="narrow--xxl">
          <h2>Relevant work</h2>
          <p>
            These projects demonstrate my approach to research, design systems, and digital product delivery across complex organizations.
          </p>
        </div>
      </header>

      <div class="container--md wide--md">
        <ProjectListView projects={projects} headingLevel={3} />
      </div>

      <div class="container wide margin-y-5">
        <Button href="/portfolio" utilities="theme-primary" title="View my full portfolio" />
      </div>

    </section>

    <div class="container wide margin-y-5">
      <hr />
    </div>

    <section class="container wide margin-y-5">
    
      <header>
        <h2 class="screen-reader-only">About Me</h2>
      </header>

      <div class="grid grid--column-2--lg gap-5 align-items-center margin-y-5">
        <div>
          <Image
        class="project-image"
        src={portrait}
        alt={portraitAlt}
        loading="eager"
        fetchpriority="high"
      />
        </div>
        <div>
          <h3 class="h2">More about me</h3>
          <p>
            I’m a New York–based product designer and design systems engineer. I’ve delivered transformative digital products for government, global nonprofits, education, and civic technology.
          </p>
        <Button href="/about" utilities="theme-primary" title="Read my bio" />
        </div>

      </div>

    </section>

    <div class="container wide margin-y-5">
      <hr />
    </div>

    <section id="accessibility-advocacy" class="container wide margin-y-5">
      <h2 class="screen-reader-only">Accessibility advocacy</h2>

      <figure>
        <Image
          src={accessibilityAdvocacy}
          alt="Collage of colorful social media graphics advocating for disability rights, inclusive design, opposition to accessibility overlays, and accountability for worsening web accessibility."
          loading="lazy"
          widths={[768, 1200, 2000]}
          sizes="(min-width: 1200px) 75rem, calc(100vw - 3rem)"
        />
        <figcaption class="container medium margin-y-3">
          <p class="text-align-center font-size-md">
            A selection of social media graphics I recently designed to advocate for disability rights. I wanted to challenge harmful accessibility narratives and make complex inclusive-design issues visible and memorable.
          </p>
        </figcaption>
      </figure>

    </section>

    <div class="container wide margin-y-5">
      <hr />
    </div>

    <section class="container wide margin-y-5">
      <div class="grid grid--column-2--lg gap-5 align-items-start--lg">
        <div>
          <h2>Experience at a glance</h2>
          <p>
            Working across disciplines has taught me how to move comfortably between the needs of users, organizations, and technical teams without losing sight of the people the work is meant to serve.
          </p>
        </div>

        <div class="accordion">
          {strengths.map((strength) => {
            const buttonId = `aclu-strength-${strength.id}-button`;
            const panelId = `aclu-strength-${strength.id}-panel`;

            return (
              <>
                <h3 data-accordion="heading">
                  <button
                    class="accordion__button h4"
                    id={buttonId}
                    data-accordion="button"
                    aria-controls={panelId}
                    aria-expanded="false"
                  >
                    <span class="text">{strength.title}</span>
                  </button>
                </h3>

                <div
                  class="accordion__panel"
                  id={panelId}
                  data-accordion="panel"
                  aria-labelledby={buttonId}
                  role="region"
                >
                  <div class="accordion__panel__content">
                    <p>{strength.summary}</p>

                    {strength.links.length > 0 && (
                      <ul class="nav gap-2">
                        {strength.links.map((link) => (
                          <li>
                            {link.external ? (
                              <LinkOpenNew
                                LinkText={link.title}
                                LinkUrl={link.href}
                                utilities="link"
                              />
                            ) : (
                              <a class="link" href={link.href}>
                                <span class="text">{link.title}</span>
                                <span class="icon icon-arrow-right" aria-hidden="true"></span>
                              </a>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </>
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <style>
    .aclu-logo-mask {
      aspect-ratio: 1583.27 / 560.802;
      background-color: #d9192b;
      mask: var(--aclu-logo) center / 100% 100% no-repeat;
      position: relative;
      -webkit-mask: var(--aclu-logo) center / 100% 100% no-repeat;
    }

    .aclu-logo-mask::after {
      background: var(--aclu-logo-image) center / cover no-repeat;
      content: '';
      inset: 0;
      mix-blend-mode: screen;
      opacity: 0.275;
      position: absolute;
    }

  </style>

  <script>
    import '@natura11y/core';
  </script>
</Layout>
