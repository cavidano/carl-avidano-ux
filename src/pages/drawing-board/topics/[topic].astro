---
import ListingPage from '../../../components/DrawingBoard/ListingPage.astro';
import { getDrawingBoardTags } from '../../../lib/drawing-board.js';

export function getStaticPaths() {
  return getDrawingBoardTags().map((tag) => ({
    params: { topic: tag.slug },
    props: { tag }
  }));
}

const { tag } = Astro.props;
---

<ListingPage posts={tag.posts} currentTag={tag} />
