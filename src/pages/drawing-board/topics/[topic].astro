---
import DrawingBoardPage from '../index.astro';
import { getDrawingBoardTags } from '../../../lib/drawing-board/loader.js';

export function getStaticPaths() {
  return getDrawingBoardTags().map((tag) => ({
    params: { topic: tag.slug },
    props: { tag }
  }));
}

const { tag } = Astro.props;
---

<DrawingBoardPage posts={tag.posts} currentTag={tag} />
