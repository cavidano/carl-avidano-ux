---
import Layout from '../../layouts/Layout.astro';
import GlobalHeader from '../../components/GlobalHeader/GlobalHeader.astro';
import PostList from '../../components/DrawingBoard/PostList.astro';
import TagNav from '../../components/DrawingBoard/TagNav.astro';
import { getDrawingBoardPosts } from '../../lib/drawing-board.js';

interface Props {
  posts?: ReturnType<typeof getDrawingBoardPosts>;
  currentTag?: { name: string; slug: string };
}

// Topic routes reuse this page so its wording and layout stay in one place.
const { posts = getDrawingBoardPosts(), currentTag } = Astro.props;
const introduction = 'Quick reads on my creative process, collaborations, and what I’m learning as I build accessible interfaces and design systems. I also share the smaller details that don’t always fit into a case study.';
const title = `${currentTag ? `${currentTag.name} • ` : ''}The Drawing Board • Carl Avidano`;
const description = currentTag ? `${currentTag.name} articles from The Drawing Board.` : introduction;
---

<Layout title={title} description={description} noindex={Boolean(currentTag)}>
  <GlobalHeader />

  <main id="skip-header-target" class="container wide margin-top-3 margin-top-5--lg margin-bottom-5">

    <header class="narrow margin-bottom-3 margin-bottom-5--lg">
      <h1 class="banner-headline">The Drawing Board</h1>
      <p class="font-size-md margin-bottom-0">{introduction}</p>
    </header>

    <TagNav currentTag={currentTag?.slug} />
    <PostList posts={posts} />
  </main>
</Layout>
