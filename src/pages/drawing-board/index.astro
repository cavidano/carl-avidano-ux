---
import Layout from '../../layouts/Layout.astro';
import GlobalHeader from '../../components/GlobalHeader/GlobalHeader.astro';
import PostCardRow from '../../components/DrawingBoard/PostCard/PostCardRow.astro';
import TagNav from '../../components/DrawingBoard/TagNav.astro';
import { getDrawingBoardPosts } from '../../lib/drawing-board/loader.js';

interface Props {
  posts?: ReturnType<typeof getDrawingBoardPosts>;
  currentTag?: { name: string; slug: string };
}

const { posts = getDrawingBoardPosts(), currentTag } = Astro.props;
const introduction = 'Quick reads on my creative process, collaborations, and what I’m learning as I build accessible interfaces and design systems. I also share the smaller details that don’t always fit into a neat case study.';
const seoTitle = `${currentTag ? `${currentTag.name} • ` : ''}The Drawing Board • Carl Avidano`;
const seoDescription = currentTag ? `${currentTag.name} articles from The Drawing Board.` : introduction;
---

<Layout title={seoTitle} description={seoDescription} noindex={Boolean(currentTag)}>
  <GlobalHeader />

  <main id="skip-header-target" class="container wide margin-y-6">

    <header class="narrow margin-bottom-3 margin-bottom-5--lg">
      <h1 class="banner-headline">The Drawing Board</h1>
      <p>{introduction}</p>
    </header>

    <TagNav currentTag={currentTag?.slug} />

    <ul class="grid gap-3">
      {posts.map((post, index) => (
        <li>
          <PostCardRow post={post} eager={index === 0} />
        </li>
      ))}
    </ul>
    
  </main>

</Layout>