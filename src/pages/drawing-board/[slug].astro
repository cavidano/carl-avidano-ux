---
import PostPage from '../../components/Pages/PostPage.astro';
import { getDrawingBoardPosts } from '../../lib/drawing-board.js';

export function getStaticPaths() {
  return getDrawingBoardPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}
---
<PostPage post={Astro.props.post} />
