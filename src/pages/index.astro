---
import Layout from '../layouts/Layout.astro';
import GlobalHeader from '../components/GlobalHeader/GlobalHeader.astro';
import Button from '../components/Button.astro';
import ProjectListView from '../components/ProjectListView.astro';
import PostList from '../components/DrawingBoard/PostList.astro';
import { getFeaturedProjects } from '../lib/projects.js';
import { getDrawingBoardPosts } from '../lib/drawing-board.js';

const projects = getFeaturedProjects();
const posts = getDrawingBoardPosts().slice(0, 3);
---

<Layout
  title="Carl Avidano • User experience, design systems, and accessibility"
  description="Carl Avidano is a UX leader, researcher, and inclusive design advocate specializing in digital accessibility, design systems, and front-end development."
>
  <GlobalHeader />

  <main id="skip-header-target">
  
    <section class="margin-y-6">
      
      <header class="container wide">

        <div class="width-90">
          <h1 class="banner-headline">            
            I'm a UX leader with a background in research, design systems, and digital accessibility.
          </h1>
        </div>

        <ul class="list-unstyled flex-row gap-3 margin-y-4">
          <li><span class="badge font-weight-normal font-size-rg">Senior Product Designer</span></li>
          <li><span class="badge font-weight-normal font-size-rg">15+ years of experience</span></li>
          <li><span class="badge font-weight-normal font-size-rg">Based in New York</span></li>
        </ul>

      </header>

      <div class="container--md wide--md margin-y-5">
        <ProjectListView projects={projects} />
      </div>

      <div class="container wide margin-y-5">
        <Button href="/case-studies" utilities="theme-primary" title="Explore Case Studies" />
      </div>
    
    </section>

    <div class="container wide margin-y-5">
      <hr />
    </div>

    <!-- About Me -->
    <section class="container wide margin-y-5">
      <header class="width-80">
        <h2 class="screen-reader-only">About Me</h2>
      </header>

      <ul class="grid grid--column-2--lg gap-5 margin-y-5">
        <li>
          <h3 class="h2">Who I am</h3>
          <p>
            I'm a UX leader, researcher, and inclusive design advocate with a successful track record of delivering digital products for government, nonprofits, education, healthcare, and civic technology.
          </p>
        </li>
        <li>
          <h3 class="h2">What I do</h3>
          <p>
            I help organizations understand user needs, align teams, and lead the design of inclusive digital products through research, design systems, and front-end expertise.
          </p>
        </li>
      </ul>

      <div>
        <Button href="/about" utilities="theme-primary" title="About Me" />
      </div>
    </section>

    <!-- Latest Drawing Board articles -->
    {posts.length > 0 && <>
      <div class="container wide margin-y-5">
        <hr />
      </div>

      <section id="drawing-board" class="container wide margin-y-5">
        <header class="margin-bottom-4">
          <h2 class="margin-bottom-0">The Drawing Board</h2>
        </header>

        <PostList posts={posts} compact />

        <div class="margin-top-4">
          <Button href="/drawing-board" utilities="theme-primary" title="More stories" />
        </div>
      </section>
    </>}
  </main>
</Layout>
