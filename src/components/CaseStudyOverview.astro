---
import Button from './Button.astro';
import KeyResults from './KeyResults/KeyResults.astro';

interface KeyResult {
  stat: string;
  description: string;
}

interface CaseStudy {
  myRole?: string;
  projectUrl?: string | null;
  projectButtonLabel?: string;
  keyResults?: KeyResult[];
}

interface Props {
  caseStudy?: CaseStudy;
}

const {
  caseStudy = {}
} = Astro.props as Props;

const {
  myRole = '',
  projectUrl = null,
  projectButtonLabel = 'View project',
  keyResults = []
} = caseStudy || {};

const keyResultItems = Array.isArray(keyResults) ? keyResults.filter(Boolean) : [];

const hasOverview = Astro.slots.has('default');
const hasRole = Boolean(myRole);
const hasProjectLink = Boolean(projectUrl);
const hasKeyResults = keyResultItems.length > 0;
---

{(hasOverview || hasRole || hasProjectLink || hasKeyResults) && (
  
  <div class="container wide">
    {(hasOverview || hasRole || hasProjectLink) && (
      <div
        class="grid-sidebar--right gap-5 margin-y-5"
        style="--grid-sidebar-width: min(35rem, 35%);"
      >
        {hasOverview && (
          <div class="grid-sidebar__major narrow">
            <slot />
          </div>
        )}

        {(hasRole || hasProjectLink) && (
          <div class="grid-sidebar__minor">
            <aside>
              {hasRole && (
                <>
                  <h2 class="h5">My role</h2>
                  <p class="margin-bottom-0">{myRole}</p>
                </>
              )}

              {hasProjectLink && (
                <div class="margin-top-3">
                  <Button
                    href={projectUrl}
                    title={projectButtonLabel}
                    iconEndHandle="open-new"
                    target="_blank"
                    rel="noreferrer"
                    utilities="font-size-sm"
                  />
                </div>
              )}
            </aside>
          </div>
        )}
      </div>
    )}

    {hasKeyResults && (
      <KeyResults results={keyResultItems} />
    )}

    <hr class="margin-y-5" />
  </div>
)}
