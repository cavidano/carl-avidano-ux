---
import Layout from '../../layouts/Layout.astro';
import GlobalHeader from '../GlobalHeader/GlobalHeader.astro';
import Button from '../Button.astro';
import ProjectListView from '../ProjectListView.astro';
import PostList from '../DrawingBoard/PostList.astro';
import { getFeaturedProjects } from '../../lib/projects.js';
import { getDrawingBoardPosts } from '../../lib/drawing-board.js';

import { getSiteId } from '../../lib/site-paths.js';
import { getSiteCopy } from '../../lib/sites.js';

const siteId = getSiteId(Astro.url.pathname);
const isApplicationSite = siteId !== 'main';
const { home: copy, drawingBoard } = getSiteCopy(Astro.url.pathname);
const projects = getFeaturedProjects(siteId);
const posts = getDrawingBoardPosts(siteId);
const homepagePosts = isApplicationSite
  ? posts.filter((post) => post.frontmatter.isFeatured === true)
    .sort((a, b) => (a.frontmatter.sortOrder ?? Infinity) - (b.frontmatter.sortOrder ?? Infinity))
  : posts.slice(0, 3);
const articlesIntroduction = 'articlesIntroduction' in copy ? copy.articlesIntroduction : undefined;
const { title, description } = copy;
const hasHero = Astro.slots.has('hero');
---

<Layout title={title} description={description}>

  <slot name="hero"><GlobalHeader /></slot>

  <main id="skip-header-target">

    <section id={isApplicationSite ? 'projects' : undefined} class={isApplicationSite ? 'margin-bottom-5' : 'margin-y-5'}>

      {!hasHero && <header class="container wide">
        <div class="width-80--xxl">
          <h1 class="banner-headline">
            {copy.headline}
          </h1>
        </div>
      </header>}

      {isApplicationSite && <header class="container wide">
        <hr class="margin-bottom-4 margin-bottom-5--lg" />
        <h2 class="margin-bottom-3">Curated case studies</h2>
        {'projectsIntroduction' in copy && <p class="medium margin-bottom-0">{copy.projectsIntroduction}</p>}
      </header>}

      <div class="container--md wide--md">
        <ProjectListView
          projects={projects}
          headingLevel={isApplicationSite ? 3 : 2}
          headingClass={isApplicationSite ? 'h2' : undefined}
          margin={isApplicationSite ? 'margin-top-4 margin-top-5--lg margin-bottom-5' : undefined}
        />
      </div>

      {!isApplicationSite && <div class="container wide margin-y-5">
        <Button href="/portfolio" utilities="theme-primary" title={copy.workButton} />
      </div>}
    </section>

    <div class="container wide margin-y-5">
      <hr />
    </div>

    <section class="container wide margin-y-5">

      <header class="width-80">
        <h2 class="screen-reader-only">{copy.aboutHeading}</h2>
      </header>

      <ul class="grid grid--column-2--lg gap-5 margin-y-5">
        <li>
          <h3 class="h2">{copy.whoHeading}</h3>
          <p>
            {copy.who}
          </p>
        </li>

        <li>
          <h3 class="h2">{copy.whatHeading}</h3>
          <p>
            {copy.what}
          </p>
        </li>
      </ul>

      <div>
        <Button href="/about" utilities="theme-primary" title={copy.aboutButton} />
      </div>
    </section>

    {homepagePosts.length > 0 && <div class="container wide margin-y-5">
      <hr />
    </div>}

    {homepagePosts.length > 0 && <section id="drawing-board" class="container wide margin-y-5">
      <header class="margin-bottom-4">
        <h2 class={articlesIntroduction ? 'margin-bottom-3' : 'margin-bottom-0'}>{drawingBoard.headline}</h2>
        {articlesIntroduction && <p class="medium margin-bottom-0">{articlesIntroduction}</p>}
      </header>

      <PostList posts={homepagePosts} compact />

      <div class="margin-top-4">
        <Button href="/drawing-board" utilities="theme-primary" title={copy.storiesButton} />
      </div>
    </section>}

  </main>

</Layout>
