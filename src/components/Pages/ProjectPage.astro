---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import GlobalHeader from '../GlobalHeader/GlobalHeader.astro';
import { getSiteId } from '../../lib/site-paths.js';
import SiteLink from '../SiteLink.astro';
import { getDrawingBoardPosts } from '../../lib/drawing-board.js';
import PostList from '../DrawingBoard/PostList.astro';
import CaseStudyOverview from '../CaseStudyOverview.astro';
import Divider from '../Divider.astro';
import FigureSideBySide from '../FigureSideBySide.astro';
import FigureSingle from '../FigureSingle.astro';
import IntroBlock from '../IntroBlock.astro';
import LinkOpenNew from '../LinkOpenNew.astro';
import ProjectLinkButton from '../ProjectLinkButton.astro';
import TextBlock from '../TextBlock.astro';
import ThemeWrapper from '../ThemeWrapper.astro';

interface ProjectFrontmatter {
  title: string;
  description: string;
  tagline?: string;
  primaryColor: string;
  primaryTextColor: string;
  secondaryColor: string;
  secondaryTextColor: string;
}

interface Project {
  slug: string;
  marqueeImage: ImageMetadata;
  Content: any;
  frontmatter: ProjectFrontmatter;
}

const { project } = Astro.props as { project: Project };

const { Content, frontmatter } = project;
const relatedPosts = getDrawingBoardPosts(getSiteId(Astro.url.pathname))
  .filter((post) => post.frontmatter.projectUrl?.replace(/\/+$/, '') === `/portfolio/${project.slug}`)
  .slice(0, 3);
const mdxComponents = {
  a: SiteLink,
  CaseStudyOverview,
  Divider,
  FigureSideBySide,
  FigureSingle,
  IntroBlock,
  LinkOpenNew,
  ProjectLinkButton,
  TextBlock,
  ThemeWrapper
};
const title = `${frontmatter.title} • Carl Avidano • UX Manager`;
const description = frontmatter.description;
const projectThemeStyles = `--primary: ${frontmatter.primaryColor}; --primary-text: ${frontmatter.primaryTextColor}; --secondary: ${frontmatter.secondaryColor}; --secondary-text: ${frontmatter.secondaryTextColor};`;
---
<Layout
  title={title}
  description={description}
  image={project.marqueeImage}
  imageAlt={`${frontmatter.title} case study`}
>
  <div class="theme-primary overflow-hidden" style={projectThemeStyles}>

    <div>

      <GlobalHeader />

      <header class="marquee">

        <div class="container wide">

          <div class="grid grid--column-7--xl align-items-end--xl gap-5--xl margin-top-3 margin-top-5--lg">

            <div class="grid__colspan-3--xl">

              <div class="margin-bottom-5 margin-top-5--lg">
                <h1 class="banner-headline">
                  {frontmatter.title}
                </h1>
                <p>
                  {frontmatter.tagline || frontmatter.description}
                </p>
              </div>

            </div>

            <div class="grid__colspan-4--xl">
              <Image
                class="project-image"
                src={project.marqueeImage}
                alt=""
                loading="eager"
                fetchpriority="high"
              />
            </div>

          </div>

        </div>

      </header>

    </div>

  </div>

  <main id="skip-header-target" style={projectThemeStyles}>
    <article class="margin-y-5">
      <Content components={mdxComponents} />
    </article>

    {relatedPosts.length > 0 && (
      <section id="from-the-drawing-board" class="container wide margin-y-5">
        <hr class="margin-bottom-5" />
        <header class="margin-bottom-4">
          <h2 class="margin-bottom-0">From the Drawing Board</h2>
        </header>
        <PostList posts={relatedPosts} compact />
      </section>
    )}
  </main>
</Layout>
