---
import './style.scss';
import KeyResultsCard from './KeyResultsCard.astro';
import { getSiteId } from '../../lib/site-paths.js';

interface Props {
  results?: { stat: string; description: string }[];
}

const { results = [] } = Astro.props;
const applicationSite = getSiteId(Astro.url.pathname) !== 'main';
---

<div class:list={['margin-y-5', applicationSite ? 'key-results--circles medium' : 'key-results--plain']}>
  
  <div class="key-results-grid">
    {results.length > 0 ? (
      results.map(({ stat, description }) => (
        <KeyResultsCard stat={stat} description={description} />
      ))
    ) : (
      <slot />
    )}
  </div>
  
</div>
