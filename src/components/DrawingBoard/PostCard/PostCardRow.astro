---
import SiteLink from '../../SiteLink.astro';
import AnimatedImage from '../../AnimatedImage.astro';
import PostMeta from '../PostMeta.astro';
import PostTags from '../PostTags.astro';
import { getDrawingBoardImageOptions } from '../../../lib/drawing-board/loader.js';
import './style.scss';

const { post, eager = false } = Astro.props;
const { slug, frontmatter, image } = post;
---

<article class="drawing-board-post subtle-fill-1 height-100 position-relative grid grid--column-2--xxl align-items-center">

  <AnimatedImage
    {...getDrawingBoardImageOptions(image)}
    animatedSrc={frontmatter.animatedImage}
    class="display-block width-100"
    alt=""
    widths={[480, 720, 960, 1200]}
    sizes="(min-width: 1440px) 43vw, 85vw"
    loading={eager ? 'eager' : 'lazy'}
  />

  <div class="narrow container padding-y-3">
    
    <PostMeta frontmatter={frontmatter} />
    
    <h2 class="h3">
      <SiteLink class="drawing-board-post-link" href={`/drawing-board/${slug}`}>
        {frontmatter.title}
      </SiteLink>
    </h2>
    
    <p class="margin-bottom-3">{frontmatter.description}</p>
    <PostTags tags={post.tags} />
  
  </div>
  
</article>