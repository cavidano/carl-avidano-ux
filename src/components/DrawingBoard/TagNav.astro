---
import SiteLink from '../SiteLink.astro';
import { getDrawingBoardTags } from '../../lib/drawing-board.js';
import { getSiteId } from '../../lib/site-paths.js';

const { currentTag } = Astro.props;
const items = [
  { name: 'All articles', slug: undefined, href: '/drawing-board' },
  ...getDrawingBoardTags(getSiteId(Astro.url.pathname))
];
---

<nav aria-label="Article tags" class="margin-bottom-3 margin-bottom-5--lg">
  <ul class="list-unstyled flex-row gap-2 font-size-sm margin-bottom-0">
    {items.map(({ name, slug, href }) => (
      <li>
        <SiteLink
          class:list={['badge', { 'theme-primary': slug === currentTag }]}
          href={href}
          aria-current={slug === currentTag ? 'page' : undefined}
        >{name}</SiteLink>
      </li>
    ))}
  </ul>
</nav>
