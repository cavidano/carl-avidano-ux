---
import SiteLink from '../SiteLink.astro';
interface Props {
  tags: { name: string; href: string }[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={['drawing-board-tags list-unstyled flex-row gap-2 margin-bottom-0', className]}>
    {tags.map(({ name, href }) => (
      <li><SiteLink class="badge" href={href}>{name}</SiteLink></li>
    ))}
  </ul>
)}
