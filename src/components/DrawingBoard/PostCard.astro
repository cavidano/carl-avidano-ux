---
import { Image } from 'astro:assets';
import PostMeta from './PostMeta.astro';
import { getDrawingBoardImageOptions } from '../../lib/drawing-board.js';
import './post-card.scss';

const { post, compact = false, headingLevel = 2, eager = false } = Astro.props;
const { slug, frontmatter, image } = post;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<article class="height-100">
  <a
    class:list={[
      'drawing-board-post-link subtle-fill-1 height-100',
      compact
        ? 'card'
        : 'grid grid--column-2--lg align-items-center gap-5'
    ]}
    href={`/drawing-board/${slug}`}
  >
    <Image
      {...getDrawingBoardImageOptions(image)}
      class="display-block width-100"
      alt=""
      widths={[480, 720, 960, 1200]}
      sizes={compact ? '(min-width: 992px) 30vw, 90vw' : '(min-width: 992px) 43vw, 85vw'}
      loading={eager ? 'eager' : 'lazy'}
    />
    <div class={compact ? 'padding-3' : 'narrow padding-x-3 padding-bottom-3 padding-0--lg'}>
      <PostMeta frontmatter={frontmatter} />
      <Heading class:list={['drawing-board-post-title', compact ? 'h4' : 'h3']}>
        {frontmatter.title}
      </Heading>
      <p class:list={['margin-bottom-3', { 'font-size-md': compact }]}>{frontmatter.description}</p>
      <span class="badge">{frontmatter.topic}</span>
    </div>
  </a>
</article>
