---
const {
  caption = null,
  className = '',
  isContained = true,
  margin = 'margin-y-5',
  width = 'wide'
} = Astro.props;

const hasCaption = caption || Astro.slots.has('caption');
const containerClasses = ['container wide', margin].filter(Boolean).join(' ');
const figureClasses = [
  isContained && width,
  !isContained && margin,
  className
].filter(Boolean).join(' ');
---
{isContained ? (
  <div class={containerClasses}>
    <figure class={figureClasses}>
      <slot />
      {hasCaption && (
        <figcaption class="font-size-md">
          <slot name="caption"><p><em>{caption}</em></p></slot>
        </figcaption>
      )}
    </figure>
  </div>
) : (
  <figure class={figureClasses}>
    <slot />
    {hasCaption && (
      <figcaption class="font-size-md">
        <slot name="caption"><p><em>{caption}</em></p></slot>
      </figcaption>
    )}
  </figure>
)}
