---
import { Image, type LocalImageProps } from 'astro:assets';
import MediaControl from './MediaControl/index.astro';

type Props = LocalImageProps & {
  animatedSrc?: string;
  animatedType?: string;
  autoplay?: boolean;
};

const { animatedSrc, animatedType = 'image/gif', autoplay = true, ...imageProps } = Astro.props;
---

<div class="position-relative" data-animated-image={animatedSrc} data-autoplay={autoplay}>
  <picture class="display-block">
    {animatedSrc && <source type={animatedType} />}
    <Image {...imageProps} />
  </picture>
  {animatedSrc && (
    <MediaControl
      class="motion-toggle"
      icon="pause"
      aria-label="Pause animation"
      hidden
    />
  )}
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-animated-image]').forEach((image) => {
    const source = image.querySelector('source');
    const button = image.querySelector<HTMLButtonElement>('.motion-toggle');
    const icon = button?.querySelector('.icon');
    if (!source || !button || !icon) return;

    let playing = false;
    const setPlaying = (value: boolean) => {
      playing = value;
      source.srcset = playing ? image.dataset.animatedImage! : '';
      button.setAttribute('aria-label', playing ? 'Pause animation' : 'Play animation');
      icon.classList.toggle('icon-pause', playing);
      icon.classList.toggle('icon-play', !playing);
    };

    const autoplay = image.dataset.autoplay !== 'false';
    setPlaying(autoplay && !reducedMotion.matches);
    button.hidden = false;
    button.addEventListener('click', () => setPlaying(!playing));
    reducedMotion.addEventListener('change', (event) => setPlaying(autoplay && !event.matches));
  });
</script>
