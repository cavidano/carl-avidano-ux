---
const {
  margin = 'margin-y-5',
  width = 'wide',
  stackOnMobile = false
} = Astro.props;

const groupWidth = width === 'medium' ? 'medium' : 'wide';
const groupClasses = [groupWidth, margin].filter(Boolean).join(' ');
---

<div class="container wide">
  
  <div class={groupClasses}>
    <div class:list={["grid gap-3", stackOnMobile ? "grid--column-1 grid--column-2--md" : "grid--column-2"]}>
      <slot />
    </div>
  </div>
  
</div>