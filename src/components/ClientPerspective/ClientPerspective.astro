---
import './style.scss';

interface ClientPerspective {
  quote: string | string[];
  quoteHighlight?: string;
  name: string;
  role?: string;
  organization?: string;
  engagement?: string;
  sourceUrl?: string;
}

interface Props {
  clientPerspective: ClientPerspective;
}

const { clientPerspective } = Astro.props as Props;
const {
  quote,
  quoteHighlight,
  name,
  role,
  organization,
  engagement,
  sourceUrl
} = clientPerspective;

const quoteParagraphs = (Array.isArray(quote) ? quote : [quote])
  .filter(Boolean)
  .map((paragraph) => {
    const highlightStart = quoteHighlight
      ? paragraph.indexOf(quoteHighlight)
      : -1;

    if (highlightStart < 0 || !quoteHighlight) {
      return {
        before: paragraph,
        highlight: '',
        after: ''
      };
    }

    return {
      before: paragraph.slice(0, highlightStart),
      highlight: quoteHighlight,
      after: paragraph.slice(highlightStart + quoteHighlight.length)
    };
  });
---

<div class="container wide margin-y-5">

  <section>

    <h2>Client perspective</h2>

    <blockquote class="blockquote client-perspective" cite={sourceUrl}>

      {quoteParagraphs.map(({ before, highlight, after }) => (
        <p>
          {before}
          {highlight && <strong>{highlight}</strong>}
          {after}
        </p>
      ))}

      <footer class="font-size-md">
        <strong>{name}</strong>
        {(role || organization) && (
          <div>{[role, organization].filter(Boolean).join(', ')}</div>
        )}
        {engagement && (
          <em>{engagement}</em>
        )}
      </footer>
    </blockquote>

  </section>

</div>