---
import { Image, getImage } from 'astro:assets';
import MediaControl from './MediaControl/index.astro';

const {
  src,
  alt,
  caption = null,
  className = '',
  width,
  widths,
  sizes,
  quality
} = Astro.props;

const fullImage = await getImage({ src, quality });
---

<button
  type="button"
  class:list={['lightbox-thumbnail', className]}
  data-lightbox="image"
  data-lightbox-src={fullImage.src}
  data-lightbox-caption={caption}
  data-lightbox-alt={alt}
  aria-label={`Enlarge ${caption || 'image'}`}
>
  <Image class="display-block width-100" src={src} alt={alt} width={width} widths={widths} sizes={sizes} quality={quality} />
  <MediaControl as="span" icon="zoom-in" aria-hidden="true" />
</button>

<script>
  import '@natura11y/core';
</script>
