---
import GlobalHeader from '../GlobalHeader/GlobalHeader.astro';
import './style.scss';

interface Props {
  logo: { light: string; dark: string; alt: string; width: number; height: number };
  headline: string;
  introduction: string;
  context?: string;
}

const { logo, headline, introduction, context } = Astro.props;
---

<div class="application-hero">
  <div class="application-hero__header">
    <GlobalHeader />
  </div>

  <div class="application-hero__content container wide padding-y-4 padding-y-5--lg">
    {(['light', 'dark'] as const).map((theme) => (
      <img
        class={`application-logo application-logo--${theme} display-block margin-bottom-4`}
        src={logo[theme]}
        alt={logo.alt}
        width={logo.width}
        height={logo.height}
      />
    ))}
    {context && <p class="font-size-md margin-bottom-3">{context}</p>}
    <h1 class="banner-headline width-80--xxl margin-bottom-3">{headline}</h1>
    <p class="narrow margin-bottom-0">
      {introduction}
    </p>
  </div>
</div>
