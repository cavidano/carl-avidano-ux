---
import Button from '../Button.astro';
import KeyResults from '../KeyResults/index.astro';
import LinkOpenNew from '../LinkOpenNew.astro';
import './style.scss';

interface MetadataItem {
  label: string;
  value: string;
  href?: string;
}

interface KeyResult {
  stat: string;
  description: string;
}

interface CaseStudy {
  myRole?: string;
  metadata?: MetadataItem[];
  projectUrl?: string | null;
  projectButtonLabel?: string;
  keyResults?: KeyResult[];
}

interface Props {
  caseStudy?: CaseStudy;
  showDivider?: boolean;
}

const {
  caseStudy = {},
  showDivider = true
} = Astro.props as Props;

const {
  myRole = '',
  metadata = [],
  projectUrl = null,
  projectButtonLabel = 'View project',
  keyResults = []
} = caseStudy || {};

const keyResultItems = Array.isArray(keyResults) ? keyResults.filter(Boolean) : [];

const hasOverview = Astro.slots.has('default');
const hasRole = Boolean(myRole);
const hasProjectLink = Boolean(projectUrl);
const hasKeyResults = keyResultItems.length > 0;
const hasMetadata = metadata.length > 0;
---

{(hasOverview || hasRole || hasProjectLink || hasKeyResults || hasMetadata) && (
  
  <div class="container wide">

    {(hasOverview || hasRole || hasProjectLink || hasMetadata) && (
     
      <div class="case-study-overview__layout grid-sidebar--right gap-5 margin-y-5">
        
        {hasOverview && (
          <div class="grid-sidebar__major narrow">
            <slot />
          </div>
        )}

        {(hasRole || hasProjectLink || hasMetadata) && (
          <div class="grid-sidebar__minor">
            <aside>
              {hasMetadata && (
                <dl class="case-study-metadata">
                  {metadata.map(({ label, value, href }) => (
                    <Fragment>
                      <dt>{label}</dt>
                      <dd>
                        {href ? (
                          <LinkOpenNew LinkText={value} LinkUrl={href} utilities="link gap-1 font-weight-normal" />
                        ) : value}
                      </dd>
                    </Fragment>
                  ))}
                </dl>
              )}

              {hasRole && (
                <>
                  <h2 class="h5">My role</h2>
                  <p class="margin-bottom-0">{myRole}</p>
                </>
              )}

              {hasProjectLink && (
                <div class={hasMetadata ? 'margin-top-4' : 'margin-top-3'}>
                  <Button
                    href={projectUrl}
                    title={projectButtonLabel}
                    iconEndHandle="open-new"
                    target="_blank"
                    rel="noreferrer"
                    utilities="font-size-sm"
                  />
                </div>
              )}
            </aside>
          </div>
        )}
      </div>
    )}

    {hasKeyResults && (
      <KeyResults results={keyResultItems} />
    )}

    {showDivider && <hr class="margin-y-5" />}
  </div>
)}
