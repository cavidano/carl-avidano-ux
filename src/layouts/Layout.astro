---
import type { ImageMetadata } from 'astro';
import Footer from '../components/Footer.astro';
import { getSiteBase, siteHref } from '../lib/site-paths.js';
import defaultSocialImage from '../images/carl-avidano-16x9.jpg';
import '@natura11y/icons/dist/natura11y-icons.css';
import '../styles/global.scss';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  socialTitle?: string;
  article?: {
    date: string;
    tags: string[];
  };
  noindex?: boolean;
}

const {
  title = 'Carl Avidano • UX Manager',
  description = 'Carl Avidano is a UX leader, researcher, and inclusive design advocate specializing in digital accessibility, design systems, and front-end development.',
  image = defaultSocialImage,
  imageAlt = 'Portrait of Carl Avidano',
  imageWidth = typeof image === 'string' ? undefined : image.width,
  imageHeight = typeof image === 'string' ? undefined : image.height,
  imageType,
  socialTitle = title,
  article,
  noindex = false
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const applicationSite = Boolean(getSiteBase(Astro.url.pathname));
const canonicalUrl = Astro.url.pathname === '/'
  ? siteUrl.origin
  : new URL(Astro.url.pathname, siteUrl).href;
const socialImagePath = typeof image === 'string' ? image : image.src;
const socialImageUrl = new URL(socialImagePath, siteUrl).href;
const authorUrl = new URL(siteHref('/about', Astro.url.pathname), siteUrl).href;
const robots = (noindex || applicationSite) ? 'noindex, follow' : article ? 'max-image-preview:large' : undefined;
const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: socialTitle,
  description,
  url: canonicalUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  datePublished: article.date,
  author: { '@type': 'Person', name: 'Carl Avidano', url: authorUrl },
  image: {
    '@type': 'ImageObject',
    url: socialImageUrl,
    width: imageWidth,
    height: imageHeight,
    caption: imageAlt
  },
  keywords: article.tags,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'Blog',
    name: 'The Drawing Board',
    url: new URL(siteHref('/drawing-board', Astro.url.pathname), siteUrl).href
  }
} : undefined;
---

<!doctype html>

<html lang="en" class="theme-dark">
  
  <head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {article && <meta name="author" content="Carl Avidano" />}
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Carl Avidano" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageType && <meta property="og:image:type" content={imageType} />}
    {article && <>
      <meta property="article:published_time" content={article.date} />
      <meta property="article:author" content={authorUrl} />
      {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {articleSchema && <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')}
    />}

    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inclusive+Sans:ital,wght@0,300..700;1,300..700&display=swap" />
    
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('preferred-theme') || 'dark';
          document.documentElement.className = savedTheme === 'light' ? 'theme-canvas' : 'theme-dark';
        } catch {
          document.documentElement.className = 'theme-dark';
        }
      })();
    </script>
  </head>

  <body>
    
    <div class="skip-links">
      <a href="#skip-header-target">Jump to main content</a>
    </div>
    
    <slot />
       
    <Footer />
    
    <script is:inline>
      (() => {
        /**
         * @param {string} theme
         */
        const setTheme = (theme) => {
          document.documentElement.className = theme === 'light' ? 'theme-canvas' : 'theme-dark';
          localStorage.setItem('preferred-theme', theme);
        };

        document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
          const nextTheme = document.documentElement.classList.contains('theme-canvas') ? 'dark' : 'light';
          setTheme(nextTheme);
        });

        document.querySelector('[data-back-to-top]')?.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      })();
    </script> 

  </body>

</html>
